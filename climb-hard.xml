<?xml version="1.0" encoding="UTF-8" ?>
<Module>
  <ModulePrefs title="Climb Hard" />
  <Content type="html"><![CDATA[
<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8"/>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"/>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/schoolflashx/x774@main/TemplateData/style.css"/>
    
    <script>
        (function() {
            function MockGamePush() {}
            MockGamePush.GameReady = function() { return true; };
            MockGamePush.GameplayStart = function() { return true; };
            MockGamePush.GameplayStop = function() { return true; };
            MockGamePush.Init = function() { return Promise.resolve(); };
            MockGamePush.Language = function() { return "en"; };
            MockGamePush.IsMobile = function() { return false; };
            MockGamePush.PlayerAdd = function() { return true; };
            MockGamePush.PlayerSet = function() { return true; };
            MockGamePush.PlayerGet = function() { return 0; };
            MockGamePush.PlayerSync = function() { return Promise.resolve(); };
            MockGamePush.AdsShowFullscreen = function() { return true; };
            MockGamePush.AdsShowRewarded = function() { return true; };
            MockGamePush.AdsShowPreloader = function() { return true; };
            MockGamePush.LeaderboardOpen = function() { return true; };
            MockGamePush.AchievementsOpen = function() { return true; };

            const handler = {
                get: function(target, prop) {
                    if (typeof target[prop] === 'undefined') {
                        return function() { return true; };
                    }
                    return target[prop];
                }
            };

            window.GamePush = new Proxy(MockGamePush, handler);
            window.GamePushUnity = function() {
                return {
                    init: function() {},
                    language: function() { return "en"; },
                    gameReady: function() {},
                    gameplayStart: function() {},
                    gameplayStop: function() {},
                    isMobile: function() { return false; },
                    ads: { showPreloader: function() {}, showFullscreen: function() {}, showRewarded: function() {} },
                    player: { ready: Promise.resolve(), set: function() {}, add: function() {}, get: function() { return 0; } },
                    leaderboard: { open: function() {} },
                    achievements: { open: function() {} }
                };
            };

            const gpMock = {
                language: "en",
                isMobile: false,
                ads: { showPreloader: function() {}, showFullscreen: function() {} },
                player: { ready: Promise.resolve(), set: function() {}, add: function() {} },
                game: { ready: function() {} }
            };
            window.gp = new Proxy(gpMock, handler);
        })();

        var _unityAwaiter = {};
        _unityAwaiter.ready = new Promise((resolve, reject) => {
            _unityAwaiter.done = resolve;
            _unityAwaiter.abort = reject;
        });

        var _gpAwaiter = {};
        _gpAwaiter.ready = Promise.resolve(); 
        window.unityInstance = null;
    </script>
</head>
<body class="dark">
    <div id="unity-container" class="unity-desktop">
        <canvas id="unity-canvas"></canvas>
    </div>

    <div id="loading-cover">
        <div id="unity-loading-bar">
            <div id="unity-logo"><img src="https://cdn.jsdelivr.net/gh/schoolflashx/x774@main/logo.png" onerror="this.style.display='none'"/></div>
            <div id="chunk-status" style="color: white; margin-bottom: 10px; font-family: sans-serif;">g+...</div>
            <div id="unity-progress-bar-empty" style="display: none;">
                <div id="unity-progress-bar-full"></div>
            </div>
            <div class="spinner"></div>
        </div>
    </div>

    <script>
        const buildUrl = "https://cdn.jsdelivr.net/gh/schoolflashx/x774@main/Build";
        const loaderUrl = buildUrl + "/Difficult Climbing Game.loader.js";
        
        // PARÇA AYARLARI
        const dataPartCount = 6; 
        const dataBaseName = buildUrl + "/Difficult Climbing Game.data.unityweb.part";

        const config = {
            dataUrl: "", // Blob ile doldurulacak
            frameworkUrl: buildUrl + "/Difficult Climbing Game.framework.js.unityweb",
            codeUrl: buildUrl + "/Difficult Climbing Game.wasm.unityweb",
            streamingAssetsUrl: "StreamingAssets",
            companyName: "Pontypants",
            productName: "A Difficult Game About Climbing",
            productVersion: "1.0",
        };

        const container = document.querySelector("#unity-container");
        const canvas = document.querySelector("#unity-canvas");
        const loadingCover = document.querySelector("#loading-cover");
        const progressBarEmpty = document.querySelector("#unity-progress-bar-empty");
        const progressBarFull = document.querySelector("#unity-progress-bar-full");
        const spinner = document.querySelector('.spinner');
        const chunkStatus = document.querySelector('#chunk-status');

        // Parçaları birleştirme fonksiyonu
        async function fetchAndCombineData() {
            const chunks = [];
            for (let i = 0; i < dataPartCount; i++) {
                chunkStatus.innerText = `G+ ... : ${i + 1}/${dataPartCount}`;
                const response = await fetch(`${dataBaseName}${i}`);
                if (!response.ok) throw new Error("Parça yüklenemedi: " + i);
                const buffer = await response.arrayBuffer();
                chunks.push(buffer);
            }
            chunkStatus.innerText = "G+...";
            const blob = new Blob(chunks, { type: "application/octet-stream" });
            return URL.createObjectURL(blob);
        }

        async function startApp() {
            try {
                const blobUrl = await fetchAndCombineData();
                config.dataUrl = blobUrl;
                chunkStatus.style.display = "none";
                loadUnity();
            } catch (e) {
                chunkStatus.innerText = "t! z.";
                console.error(e);
            }
        }

        function loadUnity() {
            const unityLoader = document.createElement("script");
            unityLoader.src = loaderUrl;
            unityLoader.onload = () => {
                createUnityInstance(canvas, config, (progress) => {
                    spinner.style.display = "none";
                    progressBarEmpty.style.display = "";
                    progressBarFull.style.width = `${100 * progress}%`;
                }).then((unityInstance) => {
                    window.unityInstance = unityInstance;
                    _unityAwaiter.done(unityInstance);
                    loadingCover.style.display = "none";
                }).catch((message) => {
                    console.error(message);
                });
            };
            document.body.appendChild(unityLoader);
        }

        container.className = "unity-desktop";
        startApp();

        document.addEventListener("pointerdown", () => {
            container.focus();
            window.focus();
            canvas.focus();
        });
    </script>
    
    <!-- Sticky Bottom Center Ad (728x90) with Smooth Slide-Out and Reappearance -->






</body>
</html>
  ]]></Content>
</Module>
