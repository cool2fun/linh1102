<Module>
  <ModulePrefs title="Meccha Chameleon" />
  <Content type="html"><![CDATA[
<!DOCTYPE html>
<html lang="en-us">
<head>
<meta charset="utf-8"/>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/school-management-google/mecha@main/style.css"/>
<style>
  canvas:focus{outline:none;}
  html,body{padding:0;margin:0;overflow:hidden;overscroll-behavior:none;
    -webkit-touch-callout:none;-webkit-user-select:none;-moz-user-select:none;
    -ms-user-select:none;user-select:none;-webkit-tap-highlight-color:rgba(0,0,0,0);height:100%;}
</style>
<script>
window.ysdk = window.ysdk || { adv: { showBannerAdv: function(){}, hideBannerAdv: function(){}, getBannerAdvStatus: function(){ return Promise.resolve({ stickyAdvIsShowing: false }); }, showFullscreenAdv: function(){}, showInterstitial: function(){}, showRewarded: function(){} } };
window.YaGames = window.YaGames || { init: function(){ return Promise.resolve(window.ysdk); } };
window.bridge = window.bridge || { advertisement: window.ysdk.adv };
</script>
</head>
<body class="dark">
<div id="unity-container" class="unity-desktop">
  <canvas id="unity-canvas" tabindex="-1"></canvas>
</div>
<div id="loading-cover" style="display:none;">
  <div id="unity-loading-bar">
    <div id="unity-progress-bar-empty" style="display:none;">
      <div id="unity-progress-bar-full"></div>
    </div>
    <div class="spinner"></div>
  </div>
</div>

<!-- YaGames stub -->
<script>
window.YaGames = { init: function() {
  var sdk = {
    environment:{ app:{id:'0'}, i18n:{lang:'en',tld:'com'}, browser:{lang:'en'}, payload:null },
    deviceInfo:{ type:'desktop',
      isMobile:function(){return false;}, isDesktop:function(){return true;},
      isTablet:function(){return false;}, isTV:function(){return false;}
    },
    adv:{
      showFullscreenAdv:function(o){ if(o&&o.callbacks&&o.callbacks.onClose) o.callbacks.onClose(false); },
      showRewardedVideo:function(o){
        if(!o||!o.callbacks) return;
        if(o.callbacks.onOpen)     o.callbacks.onOpen();
        if(o.callbacks.onRewarded) o.callbacks.onRewarded();
        if(o.callbacks.onClose)    o.callbacks.onClose();
      },
      showBannerAdv:function(){}, hideBannerAdv:function(){},
      getBannerAdvStatus:function(){ return Promise.resolve({stickyAdvIsShowing:false}); }
    },
    auth:{ openAuthDialog:function(){ return Promise.resolve(); } },
    feedback:{
      canReview:function(){ return Promise.resolve({value:false,reason:''}); },
      requestReview:function(){ return Promise.resolve({feedbackSent:false}); }
    },
    shortcut:{
      canShowPrompt:function(){ return Promise.resolve({canShow:false}); },
      showPrompt:function(){ return Promise.resolve({outcome:'rejected'}); }
    },
    getPayments:function(){ return Promise.reject('no payments'); },
    getFlags:function(){    return Promise.resolve({}); },
    /* ysdk.leaderboards — direkt nesne (getLeaderboards() değil) */
    leaderboards:{
      setScore:function(){       return Promise.resolve(); },
      getDescription:function(){ return Promise.reject('no lb'); },
      getEntries:function(){     return Promise.reject('no lb'); }
    },
    getPlayer:function(){ return Promise.resolve({
      isAuthorized:function(){return false;}, getMode:function(){return 'lite';},
      getName:function(){return '';}, getUniqueID:function(){return '0';},
      getPhoto:function(){return '';}, getPayingStatus:function(){return 'unknown';},
      setData:function(){return Promise.resolve();}, getData:function(){return Promise.resolve({});}
    });},
    serverTime:function(){ return Promise.resolve(Date.now()); },
    on:function(){},
    features:{
      LoadingAPI:{ready:function(){}},
      GameplayAPI:{start:function(){},stop:function(){}}
    }
  };
  return Promise.resolve(sdk);
}};
</script>


<script>
const hideFullScreenButton = "";
const buildUrl = "https://cdn.jsdelivr.net/gh/school-management-google/mecha@main/Build";   /* <-- degistir */
const loaderUrl = buildUrl + "/ff.loader.js";
const config = {
  dataUrl:            buildUrl + "/ff.data.br",
  frameworkUrl:       buildUrl + "/ff.framework.js",
  codeUrl:            buildUrl + "/ff.wasm.br",
  streamingAssetsUrl: "StreamingAssets",
  companyName:        "Fly Studios Games",
  productName:        "Fiva 20",
  productVersion:     "0.0.1.7"
};

const container        = document.querySelector("#unity-container");
const canvas           = document.querySelector("#unity-canvas");
const loadingCover     = document.querySelector("#loading-cover");
const progressBarEmpty = document.querySelector("#unity-progress-bar-empty");
const progressBarFull  = document.querySelector("#unity-progress-bar-full");
const spinner          = document.querySelector('.spinner');

if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent))
  container.className = "unity-mobile";

loadingCover.style.display = "";

let StartUnityInstance;
let ygGameInstance = null;
let ysdk      = null;
let initYSDK  = false;
let initGame  = false;
let syncInit  = false;
let isVisibility  = true;
let isPausedGame  = false;
const NO_DATA = 'no data';

document.addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('visibilitychange', () => SetVisibility(!document.hidden));
window.addEventListener('blur',  () => SetVisibility(false));
window.addEventListener('focus', () => SetVisibility(true));
window.addEventListener('pointerdown', () => { FocusGame(); SetVisibility(true); });
window.addEventListener('resize', () => FocusGame());
document.addEventListener('fullscreenchange', () => FocusGame());

const oRPL = Element.prototype.requestPointerLock;
Element.prototype.requestPointerLock = async function(...args) {
  try { (args[0] ||= {}).unadjustedMovement = true; await oRPL.apply(this, args); }
  catch(err){ console.log(err); }
};

function InstallBlurFocusBlocker() {
  if (!('onblur' in document) || window.blurFocusHandlersInstalled) return;
  window.addEventListener('blur', function() {
    let btn = document.createElement('button');
    Object.assign(btn.style,{position:'fixed',top:'0',left:'0',width:'100%',height:'100%',
      zIndex:'9999',backgroundColor:'rgba(0,0,0,0)',border:'none',cursor:'default'});
    document.body.appendChild(btn);
    window.addEventListener('focus', function rem(){
      btn.parentNode && btn.parentNode.removeChild(btn);
      window.removeEventListener('focus', rem);
    });
  });
  window.blurFocusHandlersInstalled = true;
}

function FocusGame(checkingPauseStatus = true) {
  if (!canvas) return;
  requestAnimationFrame(() => {
    if (checkingPauseStatus && isPausedGame) return;
    const a = document.activeElement;
    if (a && (a.tagName==='INPUT'||a.tagName==='TEXTAREA'||a.isContentEditable)) return;
    canvas.focus({ preventScroll: true });
  });
}
function SetVisibility(v) {
  if (ysdk!==null && initGame===true && isVisibility!==v) {
    isVisibility = v;
    YG2Instance('SetFocusWindowGame', v?'true':'false');
  }
}
const PauseCallback  = () => { isPausedGame=true;  YG2Instance('SetPauseGame','true'); };
const ResumeCallback = () => { isPausedGame=false; YG2Instance('SetPauseGame','false'); FocusGame(false); };

const script = document.createElement("script");
script.src = loaderUrl;
script.onload = () => {
  StartUnityInstance = function() {
    createUnityInstance(canvas, config, (progress) => {
      spinner.style.display = "none";
      progressBarEmpty.style.display = "";
      progressBarFull.style.width = `${100 * Math.max(progress, 0.05)}%`;
    }).then((inst) => {
      ygGameInstance = inst;
      loadingCover.style.background = "";
      loadingCover.style.display = "none";
      FocusGame();
    }).catch((msg) => { console.error(msg); });
  };

  InstallBlurFocusBlocker();
  InitYSDK();
  if (IsLocalHost() || syncInit) StartUnityInstance_IfUnloaded();
};

function StartUnityInstance_IfUnloaded() {
  if (spinner.style.display !== "none") StartUnityInstance();
}
function IsLocalHost() {
  try {
    if (window.top !== window) return false;
    const h = window.location.hostname;
    if (h==="localhost"||h==="127.0.0.1"||h.endsWith(".local")) { LogStyledMessage("Local Host"); return true; }
  } catch(e){ return false; }
}
function YG2Instance(method, arg) {
  if (!ygGameInstance) return;
  const send = () => arg !== undefined
    ? ygGameInstance.SendMessage('YG2Instance', method, arg)
    : ygGameInstance.SendMessage('YG2Instance', method);
  if (!initGame) setTimeout(send, 100); else send();
}
function LogStyledMessage(msg) {
  console.log('%c' + msg, 'color:#FFDF73;background-color:#454545');
}

async function InitYSDK() {
  try {
    if (IsLocalHost()) return;
    ysdk = await YaGames.init();
    ysdk.on('game_api_pause',  PauseCallback);
    ysdk.on('game_api_resume', ResumeCallback);

    await RequestingEnvironmentData(); LogStyledMessage('Init EnvirData ysdk');
    await InitPlayer();                LogStyledMessage('Init Authorization ysdk');
    await LoadCloud();                 LogStyledMessage('Init Storage ysdk');
    await InitPayments();              LogStyledMessage('Init Payments ysdk');

    initYSDK = true;
    if (ygGameInstance) ygGameInstance.SendMessage('YG2Instance','InitSDKComplete');
    LogStyledMessage('Init YandexSDK Success');
  } catch(e) { console.error('CRASH Init SDK:', e); }

  if (!IsLocalHost() && !syncInit) StartUnityInstance_IfUnloaded();
}

function InitGame() {
  initGame = true;
  setTimeout(() => { if (isPausedGame) YG2Instance('SetPauseGame','true'); }, 100);
}

LogStyledMessage('[PluginYG2 v2.0092] [Build: 101] [Platform: YandexGames]');

/* ── Cloud ── */
var cloudSaves = NO_DATA;
function SaveCloud(jsonData, flush) {
  if (!player) { console.error('CRASH Save Cloud: no player'); return; }
  try { player.setData({saves:[jsonData]}, flush); } catch(e){ console.error(e); }
}
function LoadCloud() {
  return new Promise(resolve => {
    if (!ysdk) { Final(NO_DATA); return; }
    try {
      player.getData(["saves"]).then(data => {
        Final(data.saves ? JSON.stringify(data.saves) : NO_DATA);
      }).catch(() => { console.error('Load Cloud Error!'); Final(NO_DATA); });
    } catch(e) { console.error(e); Final(NO_DATA); }
    function Final(r){ cloudSaves=r; YG2Instance('SetLoadSaves',r); resolve(r); }
  });
}

/* ── Ads ── */
function RewardedAdvShow(id) {
  try {
    ysdk.adv.showRewardedVideo({callbacks:{
      onOpen:     () => { LogStyledMessage('Opened Rewarded Adv'); YG2Instance('OpenRewardedAdv'); },
      onClose:    () => { LogStyledMessage('Closed Rewarded Adv'); YG2Instance('CloseRewardedAdv'); FocusGame(); },
      onRewarded: () => { YG2Instance('RewardAdv', id); },
      onError:    (err) => { console.error(err); YG2Instance('ErrorRewardedAdv'); }
    }});
  } catch(err){ console.error(err); }
}

let nowFullAdOpen = false;
function InterAdvShow() {
  try {
    if (!ysdk||nowFullAdOpen) return;
    ysdk.adv.showFullscreenAdv({callbacks:{
      onOpen:  () => { LogStyledMessage('Open Interstitial Adv'); nowFullAdOpen=true; if(initGame) YG2Instance('OpenInterAdv'); },
      onClose: (was) => { nowFullAdOpen=false; if(initGame) YG2Instance('CloseInterAdv',was?'true':'false'); FocusGame(); },
      onError: (e)   => { console.error(e); nowFullAdOpen=false; YG2Instance('ErrorInterAdv'); FocusGame(); }
    }});
  } catch(e){ console.error(e); }
}

/* ── Payments ── */
var paymentsData = NO_DATA;
let payments = null;
function InitPayments(sendback) {
  return new Promise(resolve => {
    try {
      if (!ysdk) { Final(NO_DATA); return; }
      ysdk.getPayments().then(_p => {
        payments = _p;
        _p.getCatalog().then(products => {
          _p.getPurchases().then(purchases => {
            let ids=[],titles=[],descs=[],imgs=[],prices=[],pvals=[],codes=[],imgURLs=[],cons=[];
            for(let i=0;i<products.length;i++){
              ids[i]=products[i].id; titles[i]=products[i].title; descs[i]=products[i].description;
              imgs[i]=products[i].imageURI; prices[i]=products[i].price; pvals[i]=products[i].priceValue;
              codes[i]=products[i].priceCurrencyCode; imgURLs[i]=products[i].getPriceCurrencyImage("medium");
              cons[i]=!purchases.some(p=>p.productID===ids[i]);
            }
            Final(JSON.stringify({id:ids,title:titles,description:descs,imageURI:imgs,price:prices,
              priceValue:pvals,priceCurrencyCode:codes,currencyImageURL:imgURLs,consumed:cons,
              language:ysdk.environment.i18n.lang}));
          });
        });
      }).catch(e => { LogStyledMessage('Purchases not available'); Final(NO_DATA); });
    } catch(e){ console.error(e); Final(NO_DATA); }
    function Final(r){ paymentsData=r; YG2Instance('PaymentsEntries',r); resolve(r); }
  });
}
function BuyPayments(id){
  try{
    if(payments){ payments.purchase(id).then(()=>{ LogStyledMessage('Purchase Success'); ConsumePurchase(id,true); FocusGame(); })
      .catch(e=>{ console.error(e); YG2Instance('OnPurchaseFailed',id); FocusGame(); }); }
    else{ LogStyledMessage('Payments == null'); YG2Instance('OnPurchaseFailed',id); }
  }catch(e){ console.error(e); YG2Instance('OnPurchaseFailed',id); FocusGame(); }
}
function ConsumePurchase(id,ok){
  try{ if(payments) payments.getPurchases().then(ps=>{
    for(let i=0;i<ps.length;i++) if(ps[i].productID===id){
      payments.consumePurchase(ps[i].purchaseToken); if(ok) YG2Instance('OnPurchaseSuccess',id); }
  }); } catch(e){ console.error(e); }
}
function ConsumePurchases(ok){
  try{ if(payments) payments.getPurchases().then(ps=>{
    for(let i=0;i<ps.length;i++){ payments.consumePurchase(ps[i].purchaseToken); if(ok) YG2Instance('OnPurchaseSuccess',ps[i].productID); }
  }); } catch(e){ console.error(e); }
}

/* ── Leaderboard (ysdk.leaderboards direkt) ── */
function SetLeaderboard(name, score, extraData) {
  if (!ysdk) return;
  try { ysdk.leaderboards.setScore(name, score, extraData); } catch(e){ console.error(e); }
}
function GetLeaderboard(nameLB, quantityTop, quantityAround, photoSize, auth) {
  if (!ysdk) return;
  var j = {technoName:'',isDefault:false,isInvertSortOrder:false,decimalOffset:0,type:''};
  ysdk.leaderboards.getDescription(nameLB).then(res => {
    j.technoName=nameLB; j.isDefault=res.default;
    j.isInvertSortOrder=res.description.invert_sort_order;
    j.decimalOffset=res.description.score_format.options.decimal_offset;
    j.type=res.description.type;
    return ysdk.leaderboards.getEntries(nameLB,{quantityTop,includeUser:auth,quantityAround});
  }).then(res => {
    YG2Instance('LeaderboardEntries', JSON.stringify({...j,...EntriesLB(res,photoSize)}));
  }).catch(err => { if(err.code==='LEADERBOARD_PLAYER_NOT_PRESENT') LogStyledMessage('LB player not present'); console.error(err); });
}
function EntriesLB(res, photoSize) {
  let txt='', n=res.entries.length;
  let ranks=[],photos=[],names=[],scores=[],uids=[],extra=[];
  for(let i=0;i<n;i++){
    ranks[i]=res.entries[i].rank; scores[i]=res.entries[i].score;
    uids[i]=res.entries[i].player.uniqueID;
    photos[i]=res.entries[i].player.getAvatarSrc(photoSize);
    extra[i]=res.entries[i].extraData||NO_DATA;
    names[i]=res.entries[i].player.scopePermissions.public_name!=="allow"?'anonymous':res.entries[i].player.publicName;
    txt+=ranks[i]+'. '+names[i]+': '+scores[i]+'\n';
  }
  return{entries:n===0?'no data':txt,ranks,photos,names,scores,uniqueIDs:uids,extraDataArray:extra};
}

/* ── Environment ── */
var environmentData = NO_DATA;
function RequestingEnvironmentData() {
  return new Promise(resolve => {
    if (!ysdk) { Final(NO_DATA); return; }
    try {
      let ua=navigator.userAgent, browser;
      if(ua.includes('YaBrowser')||ua.includes('YaSearchBrowser')) browser='Yandex';
      else if(ua.includes('Opera')||ua.includes('OPR')) browser='Opera';
      else if(ua.includes('Firefox')) browser='Firefox';
      else if(ua.includes('MSIE')) browser='IE';
      else if(ua.includes('Edge')) browser='Edge';
      else if(ua.includes('Chrome')) browser='Chrome';
      else if(ua.includes('Safari')) browser='Safari';
      else browser='Other';
      Final(JSON.stringify({
        language:ysdk.environment.i18n.lang, domain:ysdk.environment.i18n.tld,
        deviceType:ysdk.deviceInfo.type, isMobile:ysdk.deviceInfo.isMobile(),
        isDesktop:ysdk.deviceInfo.isDesktop(), isTablet:ysdk.deviceInfo.isTablet(),
        isTV:ysdk.deviceInfo.isTV(), appID:ysdk.environment.app.id,
        browserLang:ysdk.environment.browser.lang, payload:ysdk.environment.payload,
        platform:navigator.platform, browser
      }));
    } catch(e){ console.error(e); Final(NO_DATA); }
    function Final(r){ environmentData=r; YG2Instance('SetEnvirData',r); resolve(r);
      LogStyledMessage("Environment Data: "+r); }
  });
}

/* ── Player ── */
var playerData = NO_DATA;
let player = null;
async function InitPlayer() {
  try {
    if (!ysdk) return Final(NotAuthorized(false));
    player = await ysdk.getPlayer();
    if (!player||!player.isAuthorized()) return Final(NotAuthorized(true));
    return Final(JSON.stringify({
      playerAuth:"resolved", playerName:player.getName(),
      playerId:player.getUniqueID(), playerPhoto:player.getPhoto('medium'),
      payingStatus:player.getPayingStatus()
    }));
  } catch(e){ console.error('CRASH InitPlayer:',e?.message??e); player=null; return Final(NotAuthorized(false)); }
  function Final(r){ playerData=r; YG2Instance('SetAuth',r); return r; }
}
function NotAuthorized(hasPlayer=false) {
  return JSON.stringify({
    playerAuth:"rejected", playerName:"unauthorized",
    playerId:hasPlayer&&player?player.getUniqueID():"unauthorized",
    playerPhoto:"no data", payingStatus:"unknown"
  });
}
async function OpenAuthDialog() {
  if (!ysdk) { LogStyledMessage('OpenAuthDialog: ysdk is null'); return; }
  try {
    player = await ysdk.getPlayer();
    if (player.isAuthorized()) { await InitPlayer(); YG2Instance('LoggedIn'); return; }
    try {
      await ysdk.auth.openAuthDialog();
      player = await ysdk.getPlayer();
      await InitPlayer();
      if (player.isAuthorized()) YG2Instance('LoggedIn');
      else LogStyledMessage('Auth dialog closed, still unauthorized');
    } catch(e){ await InitPlayer(); LogStyledMessage('Auth canceled:',e?.message??e); }
  } catch(e){ player=null; await InitPlayer(); LogStyledMessage('CRASH OpenAuthDialog:',e?.message??e); }
}

document.body.appendChild(script);
</script>
